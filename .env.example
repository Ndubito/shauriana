PAYPAL_ENV=sandbox

# Shop: sends the payout
SHOP_CLIENT_ID=
SHOP_CLIENT_SECRET=
SHOP_SANDBOX_EMAIL=

# Supplier: creates the invoice and receives the payout
SUPPLIER_CLIENT_ID=
SUPPLIER_CLIENT_SECRET=
SUPPLIER_SANDBOX_EMAIL=

# LLM (Gemini) for the negotiating agents
LLM_API_KEY=
LLM_MODEL=gemini-3.5-flash-lite
LLM_FALLBACK_MODELS=gemini-3.5-flash

# Public demo guard: restocks allowed per rolling hour across the site (0 = no limit)
DEMO_MAX_RUNS_PER_HOUR=20

# SQLite file (default ./data.db)
DATABASE_URL=sqlite:///./data.db
